{
  "name": "moondot",
  "version": "0.1.0-dev.0",
  "private": true,
  "description": "月句 MoonDot · 本地音乐工程项目管理系统",
  "author": "归尘回梦",
  "license": "MIT",
  "main": "out/main/index.js",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": "12.10.1"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "pnpm typecheck && electron-vite build",
    "rebuild": "electron-builder install-app-deps",
    "postinstall": "pnpm run rebuild",
    "test": "playwright test",
    "test:unit": "vitest run",
    "check": "pnpm lint && pnpm format:check && pnpm test:unit && pnpm build && pnpm test",
    "pack": "pnpm build && electron-builder --dir --publish never",
    "dist:win": "pnpm run msix:check && pnpm build && node scripts/build-msix.mjs",
    "msix:check": "node scripts/build-msix.mjs --check",
    "dist:mac": "pnpm build && electron-builder --mac --arm64 --publish never",
    "doctor": "node scripts/doctor.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@lucide/vue": "1.67.0",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "echarts": "6.1.0",
    "electron-log": "5.4.4",
    "naive-ui": "2.45.3",
    "pinia": "4.1.0",
    "vue": "3.5.44",
    "vue-router": "4.6.4",
    "wavesurfer.js": "8.0.5",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@vitejs/plugin-vue": "6.0.10",
    "@vue/test-utils": "2.5.1",
    "drizzle-kit": "0.31.11",
    "electron": "43.8.6",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  }
}
